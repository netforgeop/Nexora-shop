msgid "System status"
msgstr "وضعیت سیستم"

#: inc/admin/help-boxes.php:23
msgid "Copy the support report when asking for help. It contains versions and active plugins only — no credentials."
msgstr "هنگام درخواست پشتیبانی، گزارش پشتیبانی را کپی کنید. فقط شامل نسخه‌ها و افزونه‌های فعال است — بدون هیچ اطلاعات محرمانه."

#: inc/admin/help-boxes.php:24
